# Japanese analyzer server API config

# Gemini
GEMINI_API_URL=
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=

# Optional login password
CODE=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# 自用：自定义 OpenAI 兼容端点（客户端设置中也可填写，环境变量作为服务器端回退）
CUSTOM_OPENAI_API_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL=

# 自用：自定义 OpenAI 兼容 TTS 端点（如 OpenRouter / edge-tts-openai 部署）
CUSTOM_TTS_API_URL=
CUSTOM_TTS_API_KEY=
CUSTOM_TTS_MODEL=
CUSTOM_TTS_VOICE=
