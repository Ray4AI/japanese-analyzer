{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认窗口能力（HTTP 插件放行任意 https/http 端点，用于自定义 OpenAI 兼容接口直连）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "https://**:*" },
        { "url": "http://**" },
        { "url": "http://**:*" }
      ]
    }
  ]
}
